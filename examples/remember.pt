// Train a network, save it to a file, then load it back and keep using it —
// so a trained brain can be reused later without training all over again.
// Run with:  plaintext run examples/remember.pt

import ai
import math   // for round()

examples = [[0, 0], [0, 1], [1, 0], [1, 1]]
answers  = [[0],    [1],    [1],    [0]]        // XOR

brain = neural_network(inputs: 2, hidden: [8], outputs: 1)
brain.train(examples, answers, epochs: 3000, optimizer: adam, rate: 0.05)

print("before saving:  [1, 0] -> {round(brain.predict([1, 0])[0], 4)}")
brain.save("brain.ai")                    // writes a small text file

// Later — even in a different program — load the trained brain straight back.
loaded = load_network("brain.ai")
print("after loading:  [1, 0] -> {round(loaded.predict([1, 0])[0], 4)}")

// The loaded brain behaves exactly like the one we trained.
for every pair in examples {
    print("{pair} -> {round(loaded.predict(pair)[0], 4)}")
}
