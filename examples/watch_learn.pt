// Watch a neural network learn the XOR pattern in real time.
// Each frame runs one training round and paints the network's output across the
// whole input square, so you can see the decision boundary form.
// Run with:  plaintext run examples/watch_learn.pt

import ai

brain = neural_network(inputs: 2, hidden: [8], outputs: 1)
examples = [[0, 0], [0, 1], [1, 0], [1, 1]]
answers  = [[0],    [1],    [1],    [0]]
error = 1

game "Watch it learn" (width: 400, height: 448) {

    on update(delta) {
        // One training round per frame — the error should fall over time.
        error = brain.train_once(examples, answers, optimizer: adam, rate: 0.05)
    }

    on draw() {
        clear_screen(rgb(18, 18, 24))
        // Paint a 40x40 heatmap of what the network predicts across the square.
        row = 0
        repeat 40 times {
            col = 0
            repeat 40 times {
                out = brain.predict([col / 40, row / 40])
                shade = out[0] * 255
                draw_rectangle(col * 10, row * 10, 10, 10, rgb(shade, shade * 0.5, 255 - shade))
                increase col by 1
            }
            increase row by 1
        }
        draw_text("error: {error}", 12, 414, 22, white)
    }
}
