// Teaching a network to tell whether a point is inside a circle.
// A more realistic task than XOR: the network learns a rule from random
// examples, then we measure how well it does on points it has never seen.
// Run with:  plaintext run examples/classify.pt

import math
import ai

// The hidden rule the network must discover: inside a circle centered at
// (0.5, 0.5) with radius 0.35. The network never sees this — only examples.
make function called inside_circle(x: Number, y: Number) {
    dx = x - 0.5
    dy = y - 0.5
    if dx * dx + dy * dy < 0.35 * 0.35 {
        return 1
    }
    return 0
}

// Build a training set of random points paired with their correct labels.
examples: Number list list = []
answers: Number list list = []
repeat 400 times {
    x = random_between(0, 1)
    y = random_between(0, 1)
    examples.append([x, y])
    answers.append([inside_circle(x, y)])
}

// 2 inputs → two hidden layers → 1 output (how "inside" the point looks, 0 to 1).
brain = neural_network(inputs: 2, hidden: [12, 12], outputs: 1)
brain.train(examples, answers, epochs: 2000, optimizer: adam, rate: 0.05)

// Grade the network on 300 fresh points it was never trained on.
correct = 0
repeat 300 times {
    x = random_between(0, 1)
    y = random_between(0, 1)
    guess = brain.predict([x, y])[0]
    picked = 0
    if guess > 0.5 {
        picked = 1
    }
    if picked is inside_circle(x, y) {
        increase correct by 1
    }
}

print("accuracy on new points: {correct} / 300")
print("center (0.5, 0.5) looks like: {brain.predict([0.5, 0.5])[0]}")   // near 1 (inside)
print("corner (0.0, 0.0) looks like: {brain.predict([0.0, 0.0])[0]}")   // near 0 (outside)
