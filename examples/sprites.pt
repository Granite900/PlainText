// Loading and drawing sprites. Move the spinning ship with the arrow keys.
// Run with:  plaintext run examples/sprites.pt

x = 380
y = 280
angle = 0

game "Sprites" (width: 800, height: 600) {

    // Init statements (outside any hook) run once; values are shared by hooks.
    ship = load_sprite("examples/assets/ship.png")

    on update(delta) {
        speed = 260 * delta
        if key_down("left") { x = x - speed }
        if key_down("right") { x = x + speed }
        if key_down("up") { y = y - speed }
        if key_down("down") { y = y + speed }
        angle = angle + 90 * delta    // degrees per second
    }

    on draw() {
        clear_screen(skyblue)
        draw_text("Arrow keys move the ship", 20, 20, 20, black)
        draw_sprite(ship, 40, 60)                   // native size
        draw_sprite_scaled(ship, 120, 60, 2)        // 2× scale
        draw_sprite_rotated(ship, x, y, angle)      // rotate about center
    }
}
