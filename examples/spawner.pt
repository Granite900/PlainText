// Timers inside a game: spawn a falling circle every half second.
// Run with:  plaintext run examples/spawner.pt

import math   // for random_between()

class Drop {
    x: Number
    y: Number
    speed: Number
}

// Empty lists need an element type written out.
drops: Drop list = []

make function called spawn_drop() {
    // `random_between(lo, hi)` picks a Number in that range.
    drops.append(Drop { x: random_between(20, 780), y: 0, speed: random_between(120, 300) })
    print("spawned (total {drops.length()})")
}

game "Falling Drops" (width: 800, height: 600) {

    // Same `every` as in console programs — here it's driven by the frame loop.
    every(0.5, spawn_drop)

    on update(delta) {
        for every drop in drops {
            drop.y = drop.y + drop.speed * delta
        }
    }

    on draw() {
        clear_screen(black)
        for every drop in drops {
            draw_circle(drop.x, drop.y, 10, skyblue)
        }
        draw_text("Drops spawn every 0.5s via a timer", 20, 20, 20, white)
    }
}
